# GitLab Configuration
GITLAB_TOKEN=<your GitLab API token with 'api' scope>
GITLAB_URL=https://gitlab.com/api/v4

# AI Provider API Keys (configure the one(s) you need)

## Anthropic Claude
ANTHROPIC_API_KEY=<your Anthropic API key>

## OpenAI
OPENAI_API_KEY=<your OpenAI API key>

## Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=<your Google API key>

# AI Model Selection
# Recommended Claude models:
#   - claude-3-5-sonnet-20241022 (best balance, recommended)
#   - claude-3-5-haiku-20241022 (faster, cheaper)
#   - claude-sonnet-4-5-20250929 (preview/experimental)
# Recommended OpenAI models:
#   - gpt-5 (latest, most capable - 2025)
#   - gpt-5-mini (faster, cheaper - 2025)
#   - gpt-4o (stable, multimodal)
#   - gpt-4o-mini (cheaper alternative)
#   - o4-mini (latest reasoning model)
#   - o3 (advanced reasoning)
# Recommended Gemini models:
#   - gemini-1.5-pro (best reasoning)
#   - gemini-1.5-flash (faster, cheaper)
#   - gemini-2.0-flash-exp (experimental)
AI_MODEL=claude-3-5-sonnet-20241022

# Comment Mode
# Controls how AI review comments are posted to GitLab
# Options:
#   - global: Single comment with entire review (default, classic behavior)
#   - structured: AI generates JSON with inline comments on specific lines + summary
#                 Format: {"summary": "...", "inline_comments": [{"file": "...", "line": 42, "comment": "..."}]}
# Note: structured mode requires git commit SHAs from webhook
COMMENT_MODE=structured

# Ngrok (for local testing)
NGROK_TEST_DOMAIN=<your ngrok domain>
